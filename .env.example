# Front-end development defaults.
# These are only read when __DEV__ is true and NODE_ENV is not "test".
EXPO_PUBLIC_DEV_EMAIL=emailprueba@gmail.com
EXPO_PUBLIC_DEV_PASSWORD=password

# Set to 1 to sign in automatically on the login screen.
# Leave at 0 if you need to test the login flow or sign out.
EXPO_PUBLIC_DEV_AUTO_LOGIN=0

# API base URL. On a phone, localhost points to the phone itself.
# Use the public tunnel URL of the back-end, e.g. https://xxxx.trycloudflare.com
EXPO_PUBLIC_API_URL=http://localhost:8090
